; Engine configuration file.
config_version=5

[application]

config/name="GodotFootball"
config/features=PackedStringArray("4.7", "Forward Plus")

[physics]

; GameplayFootball's fixed 10 ms simulation tick.
common/physics_ticks_per_second=100

[rendering]

renderer/rendering_method="forward_plus"
; The rig's sun lux and floodlight lumens need physical units (§7.2).
lights_and_shadows/use_physical_light_units=true
